@@ -0,0 +1,30 @@
+import { createHighlighterCoreSync } from "shiki/core";
+import { createJavaScriptRegexEngine } from "shiki/engine/javascript";
+
+const SCOPES = {
+  comment: "comment", string: "string", "constant.numeric": "number",
+  "constant.language": "constant", "constant.other": "constant",
+  keyword: "keyword", "keyword.operator": "operator", storage: "keyword",
+  "storage.type.primitive": "type", "entity.name.function": "function",
+  "entity.name.label": "label", "entity.name.type": "type",
+  "support.function": "function", "variable.language": "variable.special",
+  punctuation: "punctuation",
+};
+
+export function textmateTheme(theme) {
+  const syntax = theme.zed?.style.syntax ?? {};
+  return {
+    name: theme.name, type: theme.type, colors: theme.colors,
+    tokenColors: Object.entries(SCOPES).map(([scope, name]) => {
+      const style = syntax[name] ?? syntax[name === "label" ? "function" : name === "variable.special" ? "variable" : name];
+      return { scope, settings: typeof style === "string" ? { foreground: style } : {
+        ...(style?.color ? { foreground: style.color } : {}),
+        fontStyle: [style?.font_style === "italic" ? "italic" : "", style?.font_weight >= 600 ? "bold" : ""].filter(Boolean).join(" "),
+      } };
+    }),
+  };
+}
+
+export function createTextmateFallback(languages = []) {
+  return createHighlighterCoreSync({ themes: [], langs: languages, engine: createJavaScriptRegexEngine() });
+}
